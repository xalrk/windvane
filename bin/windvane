#!/usr/bin/env bash
# windvane from a checkout (`windvane install` can link it into ~/.local/bin). The checkout goes on sys.path only, not
# into PYTHONPATH, which every session, check and project command started from here would inherit.
here="$(dirname "$(readlink -f "$0")")"
exec python3 -c 'import sys; sys.path[0] = sys.argv.pop(1); from windvane.cli import main; sys.exit(main())' \
    "$here/.." "$@"
